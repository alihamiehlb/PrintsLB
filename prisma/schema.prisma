// PrintsLB — Cloudflare D1 (SQLite) schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  orders    Order[]
  printJobs PrintJob[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Material {
  id           String   @id @default(cuid())
  name         String
  description  String?
  color        String?
  pricePerGram Float
  available    Boolean  @default(true)
  printerType  String   @default("FDM")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  printJobs PrintJob[]

  @@unique([name, color])
  @@map("materials")
}

model PrintJob {
  id           String         @id @default(cuid())
  userId       String
  materialId   String
  fileName     String
  fileSize     Float
  printTime    Float
  materialUsed Float
  baseCost     Float
  profit       Float
  totalPrice   Float
  status       PrintJobStatus @default(PENDING)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  material Material @relation(fields: [materialId], references: [id])
  order    Order?

  @@map("print_jobs")
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  printJobId  String?     @unique
  status      OrderStatus @default(PENDING)
  totalAmount Float
  notes       String?
  fileUrl     String?
  phoneNumber String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  printJob PrintJob?       @relation(fields: [printJobId], references: [id])
  tracking OrderTracking[]

  @@map("orders")
}

model OrderTracking {
  id          String   @id @default(cuid())
  orderId     String
  status      String
  description String
  timestamp   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_tracking")
}

model PricingSetting {
  id              String   @id @default("default")
  taxRate         Float    @default(0.0)
  serviceFee      Float    @default(2.5)
  scaleMultiplier Float    @default(1.0)
  updatedAt       DateTime @updatedAt

  @@map("pricing_settings")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  webpUrl     String?
  category    String?
  inStock     Boolean  @default(true)
  stockCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  VALIDATING
  CONFIRMED
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PrintJobStatus {
  PENDING
  CONFIRMED
  PRINTING
  COMPLETED
  FAILED
  CANCELLED
}

model HighScore {
  id         String   @id @default("global_top")
  score      Int      @default(0)
  playerName String   @default("Anonymous")
  updatedAt  DateTime @updatedAt

  @@map("high_scores")
}
