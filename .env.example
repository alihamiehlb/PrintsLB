# Database (Cloudflare D1 locally via SQLite file)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Admin seed credentials
ADMIN_EMAIL="admin@printslb.com"
ADMIN_PASSWORD="change-me-min-8-chars"

# Telegram (STL upload notifications)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Cloudflare R2 public URL (optional — enables CDN URLs for images)
R2_PUBLIC_URL=""
NEXT_PUBLIC_R2_PUBLIC_URL=""

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=""

# Security — manually banned IPs for the app-level rate limiter (comma separated)
# The primary DDoS protection is the Cloudflare WAF (see DEPLOYMENT.md).
BANNED_IPS=""

# Redis cache over HTTPS (Workers-compatible). Use a REST Redis provider such as
# Upstash, or any Atlas/Redis provider that exposes a Redis REST endpoint.
REDIS_REST_URL=""
REDIS_REST_TOKEN=""
# Upstash names are also supported if you prefer their default env names.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
